<mxfile host="build_diagrams.py"><diagram name="fault-flow" id="fault-flow"><mxGraphModel dx="1500" dy="1500" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1500" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="From sensor window to dispatched work order" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Gray boxes are steps, white diamonds are decisions made by code, the orange box is the only human decision. P1 to P10 name the decision policies tested in Gate 3." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5A6B7B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1300" height="20" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Replay&lt;/b&gt;: recorded sensor rows stream through Kinesis at 4 hours per second" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#ADB5BD;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="260" height="56" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Detect&lt;/b&gt;: each 60-minute window gets the rules baseline and the XGBoost model" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#ADB5BD;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="520" y="180" width="260" height="56" as="geometry"/></mxCell><mxCell id="c6" value="Two or more&lt;br&gt;alarm windows&lt;br&gt;in the day?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="535" y="265" width="230" height="96" as="geometry"/></mxCell><mxCell id="c7" value="No case opened" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#EBFBEE;strokeColor=#2B8A3E;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="285" width="230" height="56" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;P1&lt;/b&gt; detection&lt;br&gt;confidence high&lt;br&gt;enough?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="535" y="395" width="230" height="96" as="geometry"/></mxCell><mxCell id="c9" value="Manual review, not diagnosed" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E67700;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="415" width="230" height="56" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;P2&lt;/b&gt; rules and&lt;br&gt;model agree?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="535" y="525" width="230" height="96" as="geometry"/></mxCell><mxCell id="c11" value="Flag: manager review required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E67700;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="553" width="230" height="40" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Diagnose&lt;/b&gt;: the model proposes a cause, the Knowledge Base returns manual pages, the model quotes them" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#ADB5BD;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="520" y="655" width="260" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Verify&lt;/b&gt;: each quote must appear on its page (P4) and a second model must judge that the page supports it" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#ADB5BD;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="520" y="755" width="260" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;P3&lt;/b&gt; any supported&lt;br&gt;passage?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="535" y="860" width="230" height="96" as="geometry"/></mxCell><mxCell id="c15" value="Insufficient evidence: blocked, manual review" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C92A2A;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="880" width="230" height="56" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;P5&lt;/b&gt; manual matches the class, not the model: mark compatibility uncertain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E67700;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="120" y="870" width="300" height="60" as="geometry"/></mxCell><mxCell id="c17" value="Building&lt;br&gt;operations&lt;br&gt;fault?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="535" y="990" width="230" height="96" as="geometry"/></mxCell><mxCell id="c18" value="Operations review, no technician sent" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E67700;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="1010" width="230" height="56" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;P6&lt;/b&gt; lockout step&lt;br&gt;quoted from&lt;br&gt;a manual?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="535" y="1120" width="230" height="96" as="geometry"/></mxCell><mxCell id="c20" value="Blocked: no sourced lockout step" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C92A2A;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="1140" width="230" height="56" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Manager reviews the draft&lt;/b&gt;&lt;br&gt;approve, untick steps, or reject.&lt;br&gt;Free text cannot be added." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#E8590C;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="520" y="1245" width="260" height="74" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;P9&lt;/b&gt; no answer in 4 hours: escalated, not dispatched" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C92A2A;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="120" y="1255" width="300" height="56" as="geometry"/></mxCell><mxCell id="c23" value="Rejected with a reason" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C92A2A;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="1260" width="230" height="56" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;P7, P8&lt;/b&gt; OR-Tools&lt;br&gt;finds a qualified,&lt;br&gt;feasible slot?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="535" y="1345" width="230" height="100" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Assigned&lt;/b&gt;, with runner-up and reason" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#EBFBEE;strokeColor=#2B8A3E;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="535" y="1460" width="230" height="34" as="geometry"/></mxCell><mxCell id="c26" value="Escalated unassigned (P7) or reschedule requested (P8)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C92A2A;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="900" y="1370" width="260" height="50" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;P10&lt;/b&gt; a technician asking about another technician&#x27;s job is denied and audited" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C92A2A;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="120" y="1100" width="300" height="60" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeCol