<mxfile host="build_diagrams.py"><diagram name="security" id="security"><mxGraphModel dx="1560" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1000" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Identity and access: every request carries a verified identity" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Cognito issues the identity. API Gateway and AgentCore Gateway verify it. Code, not the model, decides what each identity may read. Each Lambda role names its own resources." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5A6B7B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1400" height="20" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Manager&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;group: manager&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Technician T01&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;group: technician,&lt;br&gt;custom:technician_id = T01&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Cognito user pool&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;SRP sign-in, ID token,&lt;br&gt;sign-up hidden&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="300" y="220" width="56" height="56" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;JWT authorizer on every route&lt;br&gt;except OPTIONS preflight&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="560" y="140" width="56" height="56" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;AgentCore Gateway&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;CUSTOM_JWT, audience = client id&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="560" y="340" width="56" height="56" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Interceptor Lambda&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;drops client caller_context,&lt;br&gt;injects token identity&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientCol