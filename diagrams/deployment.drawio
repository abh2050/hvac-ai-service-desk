=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.amplify;" vertex="1" parent="1"><mxGeometry x="400" y="450" width="52" height="52" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Vercel&lt;/b&gt;&lt;br&gt;static recorded demo, built from main&lt;br&gt;(no backend, survives teardown)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6B7B;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="250" height="70" as="geometry"/></mxCell><mxCell id="c22" value="cdk deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="image asset" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=1;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=none;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=1;" edge="1" parent="1" source="c5" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;" edge="1" parent="1" source="c5" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;Cost controls&lt;/b&gt;&lt;br&gt;Each stack carries a cost-profile tag (idle or demo). No NAT gateway. Aurora pauses at 0 ACU. Kinesis, state machines, and Fargate exist only in the demo stack. Log groups keep 7 days. Measured model cost: $0.00206 per incident on average (gate-5.json). Idle cost: not measured yet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E67700;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1010" y="540" width="440" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>