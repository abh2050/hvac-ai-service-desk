<mxfile host="build_diagrams.py"><diagram name="deployment" id="deployment"><mxGraphModel dx="1500" dy="860" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="860" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Infrastructure as code and cost profiles" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c3" value="AWS CDK in TypeScript (aws-cdk-lib 2.274.0), profile awsnew, region us-east-2. Every deploy was preceded by a posted cdk diff (reports/gate-5-phase*-diff.txt)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5A6B7B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1400" height="20" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Developer laptop&lt;/b&gt;&lt;br&gt;npx cdk diff, cdk deploy&lt;br&gt;scripts/demo-up.sh, demo-down.sh" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#ADB5BD;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="250" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;GitHub: abh2050/hvac-ai-service-desk&lt;/b&gt;&lt;br&gt;branch main" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="250" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;CloudFormation&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;CDKToolkit bootstrap v32&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#