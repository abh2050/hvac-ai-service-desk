<mxfile host="build_diagrams.py"><diagram name="knowledge-base" id="knowledge-base"><mxGraphModel dx="1560" dy="780" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="780" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Manual retrieval and citation checks" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c3" value="A quote reaches a work order only if it appears on the cited page and a second model judges that the page supports it. The database rejects unverified steps." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5A6B7B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1400" height="20" as="geometry"/></mxCell><mxCell id="c4" value="Ingest, once" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="300" height="24" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;8 OEM manual PDFs&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;SHA256 in data/SOURCES.md&lt;/font&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6B7B;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="170" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;One document per page&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;654 pages, chunking NONE,&lt;br&gt;metadata: manual_id, page, classes&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#ADB5BD;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="260" y="125" width="210" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;S3&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;kb/ prefix&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="530" y="130" width="52" height="52" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Titan text embeddings v2&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;1024 dimensions&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="52" height="52" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;S3 Vectors index&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;Knowledge Base storage&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="900" y="130" width="52" height="52" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="ingestion job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="Per case, at run time" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="300" height="24" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Case evidence&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5A6B7B&#x27;&gt;alarm hours, rules fired, feature summaries, equipment class&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#ADB5BD;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="200" height="70" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;gpt-oss-120b: propose&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;cause, component, query&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="300" y="335" width="52" height="52" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Knowledge Base Retrieve&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;filter: classes contains&lt;br&gt;equipment class, k = 6&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="500" y="335" width="52" height="52" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;gpt-oss-120b: cite&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;quotes with manual and page&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="700" y="335" width="52" height="52" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Verifier&lt;/b&gt;&lt;br&gt;1. trigram coverage of the quote on that page at least 0.6&lt;br&gt;2. gpt-oss-20b judges entailment&lt;br&gt;3. both must pass" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#E8590C;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="320" width="340" height="90" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Policy code&lt;/b&gt;&lt;br&gt;no supported passage: abstain&lt;br&gt;no sourced lockout: block&lt;br&gt;class-only match: compatibility uncertain" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1260" y="320" width="260" height="90" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Aurora: work_order_steps&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;CHECK (verified)&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;" vertex="1" parent="1"><mxGeometry x="1364" y="500" width="52" height="52" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="manual_query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="6 pages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="vector search" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c9" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="156"/><mxPoint x="990" y="285"/><mxPoint x="526" y="285"/></Array></mxGeometry></mxCell><mxCell id="c29" value="Measured in Gate 2 (reports/gate-2.json, run 3, 92 cases): 88.0% of checked citations supported, against 12.2% for the keyword baseline. On 60 held-out field days (gate-2-holdout.json): 91.5%. The guardrail wraps every model call." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5A6B7B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1400" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>