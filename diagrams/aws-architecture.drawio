<mxfile host="build_diagrams.py"><diagram name="aws-architecture" id="aws-architecture"><mxGraphModel dx="1800" dy="1160" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1160" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Uptime Desk on AWS, us-east-2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Orange badges follow one incident from replay to dispatch. The demo profile (scripts/demo-up.sh) adds the replay and detection lane and the Fargate task; everything else is the always-on idle profile." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5A6B7B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1500" height="20" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Manager&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="60" y="196" width="48" height="48" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Technician or MCP client&lt;/b&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="60" y="312" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;LBNL recorded data&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27; color=&#x27;#5A6B7B&#x27;&gt;lab and field CSV, uploaded&lt;br&gt;once to S3, read by the replay Lambda&lt;/font&g