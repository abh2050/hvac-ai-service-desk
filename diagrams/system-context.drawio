<mxfile host="build_diagrams.py"><diagram name="system-context" id="system-context"><mxGraphModel dx="1400" dy="760" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Uptime Desk: system context" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="800" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Who uses the system, what it reads, and what it calls. Dashed borders mark parts that are planned, not built." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5A6B7B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1100" height="20" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;Uptime Desk&lt;/b&gt;&lt;br&gt;&lt;br&gt;detects faults in recorded sensor data&lt;br&gt;drafts a diagnosis that quotes the manuals&lt;br&gt;waits for a manager&#x27;s approval&lt;br&gt;assigns a qualified technician&lt;br&gt;answers technicians about their own jobs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF4EC;strokeColor=#E8590C;fontColor=#232F3E;fontSize=13;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="520" y="250" width="360" height="220" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Service manager&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;approves, edits, or rejects work orders&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="160" y="180" width="48" height="48" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Field technician&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;sees own jobs and quoted steps&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="160" y="520" width="48" height="48" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;LBNL fault datasets&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:11px&#x27;&gt;recorded building sensor data, lab tests and two field rooftop units, with published fault labels&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6B7B;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="280" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;OEM equipment manuals&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:11px&#x27;&gt;8 public PDFs: Trane, Daikin, Honeywell, Siemens, Johnson Controls&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6B7B;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="560" width="280" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:11px&#x27;&gt;gpt-oss-120b, gpt-oss-20b, Titan text embeddings v2&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E6F7F4;strokeColor=#01A88D;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="160" width="280" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;MCP clients&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:11px&#x27;&gt;any agent that speaks MCP, for example Claude. Checked with direct JSON-RPC calls.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="330" width="280" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Microsoft Copilot Studio agent&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:11px&#x27;&gt;Release 3, planned: custom connector to the API (docs/copilot.md)&lt;/font&gt;" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5A6B7B;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="500" width="280" height="90" as="geometry"/></mxCell><mxCell id="c12" value="web app, Cognito sign-in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="204"/><mxPoint x="320" y="305"/></Array></mxGeometry></mxCell><mxCell id="c13" value="web app or MCP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="c6" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="544"/><mxPoint x="320" y="415"/></Array></mxGeometry></mxCell><mxCell id="c14" value="replayed through Kinesis" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="indexed page by page" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="proposals, entailment checks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.15;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="283"/><mxPoint x="960" y="205"/></Array></mxGeometry></mxCell><mxCell id="c17" value="Cognito JWT, own jobs only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;entryX=1;entryY=0.5;" edge="1" parent="1" source="c10" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="planned" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=1.5;endArrow=block;endFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;entryX=1;entryY=0.85;" edge="1" parent="1" source="c11" target="c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="960" y="545"/><mxPoint x="960" y="437"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>