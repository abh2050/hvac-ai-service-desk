<mxfile host="build_diagrams.py"><diagram name="network" id="network"><mxGraphModel dx="1500" dy="940" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="940" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Network: private by default, no NAT gateway" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c3" value="foundation-stack.ts. Lambdas that touch Aurora run in one isolated subnet and reach AWS APIs through interface endpoints. Security groups allow only the ports below." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5A6B7B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1400" height="20" as="geometry"/></mxCell><mxCell id="c4" value="VPC, 2 AZs, natGateways: 0" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;fontColor=#8C4FFF;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="1060" height="820" as="geometry"/></mxCell><mxCell id="c5" value="Public subnet, AZ a" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;fontColor=#248814;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="300" height="220" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Fargate: OR-Tools task&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;public IP, SG: no inbound&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="170" y="190" width="56" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Public subnet, AZ b" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;fontColor=#248814;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="300" height="120" as="geometry"/></mxCell><mxCell id="c8" value="unused by tasks" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6B7B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="90" y="440" width="200" height="20" as="geometry"/></mxCell><mxCell id="c9" value="Isolated subnet, AZ a: in-VPC Lambdas and endpoints" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="390" y="140" width="670" height="410" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;In-VPC Lambdas (11)&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;API, case steps, diagnose,&lt;br&gt;verify, MCP tools, db init&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="470" y="190" width="56" height="56" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;S3 gateway endpoint&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;free, route table&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.endpoints;" vertex="1" parent="1"><mxGeometry x="960" y="196" width="44" height="44" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Interface endpoints&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;bedrock-runtime&lt;br&gt;bedrock-agent-runtime&lt;br&gt;secretsmanager, states&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.endpoints;" vertex="1" parent="1"><mxGeometry x="474" y="380" width="48" height="48" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Endpoint security group&lt;/b&gt;&lt;br&gt;ingress 443 from VPC CIDR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="300" height="50" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Lambda security group&lt;/b&gt;&lt;br&gt;egress 443 to VPC CIDR (endpoints)&lt;br&gt;egress 5432 to VPC CIDR (Aurora)&lt;br&gt;egress 443 to S3 prefix list pl-7ba54012&lt;br&gt;no other egress" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="420" width="300" height="110" as="geometry"/></mxCell><mxCell id="c15" value="Isolated subnets, AZ a and AZ b (RDS needs two)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#00A4A6;fillColor=#E6F6F7;fontColor=#147EBA;" vertex="1" parent="1"><mxGeometry x="60" y="570" width="1000" height="310" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Aurora PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;Serverless v2, writer only,&lt;br&gt;not publicly accessible&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;" vertex="1" parent="1"><mxGeometry x="250" y="640" width="56" height="56" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Database security group&lt;/b&gt;&lt;br&gt;ingress 5432 from VPC CIDR only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="650" width="330" height="60" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Why one AZ for endpoints&lt;/b&gt;&lt;br&gt;Each interface endpoint costs about $7.30 per month per AZ (AWS list price, not measured). Four endpoints in one AZ instead of two saves about $29 per month. The trade-off is that the in-VPC Lambdas stop if AZ a fails." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9DB;strokeColor=#E67700;fontColor=#232F3E;fontSize=11;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="740" width="590" height="110" as="geometry"/></mxCell><mxCell id="c19" value="AWS managed services (regional)" style="points=[];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=1;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;verticalAlign=top;align=left;spacingLeft=30;dashed=0;grIcon=mxgraph.aws4.group_on_premise;strokeColor=#5A6B7B;fillColor=#FAFAFA;fontColor=#5A6B7B;dashed=1;" vertex="1" parent="1"><mxGeometry x="1120" y="90" width="350" height="820" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Bedrock runtime&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;InvokeModel, ApplyGuardrail&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1260" y="150" width="56" height="56" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Bedrock agent runtime&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;Knowledge Base Retrieve&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1260" y="300" width="56" height="56" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;Aurora secret&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1"><mxGeometry x="1260" y="450" width="56" height="56" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Step Functions&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;SendTaskSuccess, history&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="1260" y="600" width="56" height="56" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;S3&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;episodes, manuals&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1260" y="750" width="56" height="56" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;ECR, CloudWatch Logs&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#5A6B7B&#x27; style=&#x27;font-size:10px&#x27;&gt;Fargate pulls over its public IP&lt;/font&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" pare