<mxfile host="build_diagrams.py"><diagram name="case-state-machine" id="case-state-machine"><mxGraphModel dx="1300" dy="1180" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1180" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Step Functions: the case machine (uptime-desk-case)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#232F3E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c3" value="pipeline.ts. Each Lambda task returns facts; Choice states route on them. The approval wait holds a task token in Aurora until the manager acts or 4 hours pass." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#5A6B7B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="44" width="1250" height="20" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Start&lt;/b&gt;: EventBridge EndOfDay event" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#F1F3F5;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="90" width="300" height="50" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;LetWindowsLand&lt;/b&gt;  Wait 15 s" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="170" width="300" height="50" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;DecideDay&lt;/b&gt;  Lambda, policies 1 and 2" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;fontColor=#232F3E;fontSize=12;fontStyle=0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="250" width="300" height="50" as="geometry"/></mxCell><mxCell id=